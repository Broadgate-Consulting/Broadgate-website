---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
import watermark from "../assets/broadgate-symbol-ink.png";
import rayPhoto from "../assets/team/ray.jpg";
import michellePhoto from "../assets/team/michelle.jpg";
import {
  site,
  intro,
  facts,
  offerings,
  approach,
  network,
  networkMode,
  leadership,
} from "../data/site";

const teamPhotos: Record<string, ImageMetadata> = {
  ray: rayPhoto,
  michelle: michellePhoto,
};
---

<Base>
  <SiteHeader />
  <main id="main">
    <!-- Introduction -->
    <section class="section intro" id="introduction">
      <Image class="hero__watermark" src={watermark} alt="" widths={[360, 560]} sizes="480px" aria-hidden="true" />
      <div class="container">
        <div class="intro__inner">
          <p class="eyebrow">Introduction</p>
          <h2>Your Gateway to expertise in Financial Services and Operations</h2>
          <p class="intro__lede">{intro}</p>
          <div class="hero__actions">
            <a class="btn btn--primary" href="#contact">Start a conversation</a>
            <a class="btn btn--ghost" href="#offerings">See how we work</a>
          </div>
          <dl class="hero__facts">
            {
              facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <!-- Offerings -->
    <section class="section" id="offerings">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">What we do</p>
          <h2>Three connected offerings, one front door</h2>
          <p class="lede">
            Broadgate is the gateway to expertise across Financial Services and
            Operations. An introducer and enabler of relevant expertise,{" "}
            <span class="nowrap">in-house</span> and within our professional network,
            never a body shop.
          </p>
        </header>

        <div class="cards">
          {
            offerings.map((o, i) => (
              <article class="card">
                <span class="card__index">{String(i + 1).padStart(2, "0")}</span>
                <h3>{o.title}</h3>
                <p>{o.summary}</p>
                <ul>
                  {o.points.map((p) => <li>{p}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Approach -->
    <section class="section approach" id="approach">
      <div class="container approach__grid">
        <header class="section-head">
          <p class="eyebrow">Our approach</p>
          <h2>Boutique agility with institutional-grade governance</h2>
          <p class="lede">
            Underpinning all three offerings is a professionally engineered supply
            framework, so clients get responsiveness without governance risk.
          </p>
        </header>
        <ul class="approach__list">
          {
            approach.map((a) => (
              <li>
                <h3>{a.title}</h3>
                <p>{a.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Network -->
    {
      networkMode !== "hidden" && (
        <section class="section network" id="network">
          <div class="container">
            <header class="section-head">
              <p class="eyebrow">The gateway network</p>
              <h2>{network.heading}</h2>
              <p class="lede">
                {network.intro}
                {networkMode === "full" && ` ${network.sampleNote}`}
              </p>
            </header>

            {networkMode === "full" ? (
              <ul class="partners">
                {network.partners.map((p) => {
                  const url = "url" in p ? (p.url as string) : undefined;
                  const Tag = url ? "a" : "div";
                  return (
                    <li class="partner">
                      <Tag
                        class="partner__card"
                        {...(url ? { href: url, rel: "noopener", target: "_blank" } : {})}
                      >
                        <span class="partner__name">
                          {p.name}
                          {url && (
                            <span class="partner__ext" aria-hidden="true">
                              &#8599;
                            </span>
                          )}
                        </span>
                        <span class="partner__role">{p.role}</span>
                      </Tag>
                    </li>
                  );
                })}
              </ul>
            ) : (
              <p class="network__note">{network.teaserNote}</p>
            )}
          </div>
        </section>
      )
    }

    <!-- Leadership -->
    <section class="section leadership" id="leadership">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">Leadership</p>
          <h2>Three directors, hands-on in delivery</h2>
          <p class="lede">
            Broadgate is led by a small team of dedicated directors who remain
            personally involved in client engagements.
          </p>
        </header>
        <ul class="people">
          {
            leadership.map((person) => {
              const photo = person.photo ? teamPhotos[person.photo] : undefined;
              return (
                <li class="person">
                  {photo ? (
                    <Image
                      class="person__photo"
                      src={photo}
                      alt={`${person.name}, ${person.role}`}
                      widths={[160, 320]}
                      sizes="160px"
                    />
                  ) : (
                    <span class="person__photo person__photo--initials" aria-hidden="true">
                      {person.name.split(" ").map((n) => n[0]).join("")}
                    </span>
                  )}
                  <h3>{person.name}</h3>
                  <p class="person__role">{person.role}</p>
                  {person.bio ? (
                    <div class="person__bioblock">
                      <div class="person__bio" data-bio>
                        {person.bio.split("\n\n").map((para) => (
                          <p>{para}</p>
                        ))}
                      </div>
                      <button
                        class="person__more"
                        type="button"
                        data-bio-toggle
                        aria-expanded="false"
                        hidden
                      >
                        <span data-more-label>Read more</span>
                      </button>
                    </div>
                  ) : (
                    <p class="person__bio-pending">Full profile to follow.</p>
                  )}
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    <!-- Contact -->
    <section class="contact" id="contact">
      <div class="container contact__inner">
        <div>
          <p class="eyebrow">Contact</p>
          <h2>Tell us what you're trying to get done</h2>
          <p class="lede">
            Whether you need a senior pair of hands, an introduction to a
            specialist, or a route into the UK market — start with a conversation.
          </p>
        </div>
        <div class="contact__actions">
          <a class="btn btn--primary" href={`mailto:${site.email}`}>
            {site.email}
          </a>
          <a class="btn btn--ghost btn--on-navy" href={site.linkedin} rel="noopener">
            Connect on LinkedIn
          </a>
          <p class="contact__meta">{site.location}</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .section-head {
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .section-head .eyebrow {
    display: block;
    margin-bottom: 0.9rem;
  }

  .section-head h2 {
    margin-bottom: 1rem;
  }

  /* Introduction */
  .intro {
    position: relative;
    overflow: hidden;
    background: var(--warm-neutral);
    border-bottom: 1px solid var(--line);
  }

  .hero__watermark {
    position: absolute;
    right: -6%;
    top: 50%;
    transform: translateY(-50%);
    width: min(40vw, 440px);
    height: auto;
    opacity: 0.06;
    pointer-events: none;
  }

  @media (max-width: 760px) {
    .hero__watermark {
      display: none;
    }
  }

  .intro__inner {
    position: relative;
    max-width: 46rem;
  }

  .intro .eyebrow {
    display: block;
    margin-bottom: 0.9rem;
  }

  .intro h2 {
    margin-bottom: 1.25rem;
  }

  .intro__lede {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--slate);
    text-wrap: balance;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .hero__facts dt {
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.4rem;
  }

  .hero__facts dd {
    font-weight: 600;
    color: var(--navy);
    line-height: 1.35;
  }

  /* Offerings */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 2rem 1.75rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .card__index {
    font-family: var(--font-display);
    font-weight: 700;
    color: color-mix(in srgb, var(--gold) 85%, var(--ink));
    font-size: 0.95rem;
    letter-spacing: 0.1em;
  }

  .card h3 {
    margin: 0.5rem 0 0.75rem;
  }

  .card p {
    color: var(--slate);
    font-size: 0.98rem;
  }

  .card ul {
    margin: 1.5rem 0 0;
    padding: 1.1rem 0 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
    border-top: 1px solid var(--line);
  }

  .card li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.92rem;
  }

  .card li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--gold);
    border-radius: 1px;
    transform: rotate(45deg);
  }

  /* Line up the internal rows (index / title / summary / bullets) across all
     three cards so the separator above each bullet list sits at the same height. */
  @supports (grid-template-rows: subgrid) {
    @media (min-width: 901px) {
      .cards {
        grid-template-rows: auto auto auto auto;
        row-gap: 0;
      }

      .card {
        display: grid;
        grid-row: span 4;
        grid-template-rows: subgrid;
      }
    }
  }

  /* Approach */
  .approach {
    background: var(--pale-blue);
  }

  .approach__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .approach .section-head {
    margin-bottom: 0;
  }

  .approach__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .approach__list li {
    background: var(--white);
    border-radius: var(--radius);
    padding: 1.5rem 1.6rem;
    border-left: 3px solid var(--navy);
  }

  .approach__list h3 {
    margin-bottom: 0.4rem;
  }

  .approach__list p {
    color: var(--slate);
    font-size: 0.98rem;
  }

  /* Network */
  .network__note {
    max-width: 42rem;
    padding: 1.4rem 1.6rem;
    border-left: 3px solid var(--gold);
    background: var(--pale-blue);
    border-radius: var(--radius);
    color: var(--slate);
    font-size: 0.98rem;
  }

  .partners {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1rem;
  }

  .partner {
    list-style: none;
  }

  .partner__card {
    height: 100%;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    display: grid;
    gap: 0.35rem;
    align-content: start;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  a.partner__card:hover {
    border-color: var(--gold);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .partner__name {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--navy);
    font-size: 1.05rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .partner__ext {
    color: var(--gold);
    font-size: 0.85em;
  }

  .partner__role {
    color: var(--slate);
    font-size: 0.88rem;
  }

  /* Leadership */
  .people {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    /* equal-height cards while all collapsed; once one is expanded, let
       cards size to their own content so siblings don't stretch */
    align-items: stretch;
  }

  .people.has-expanded {
    align-items: start;
  }

  .person {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1.75rem;
    border: 1px solid var(--line);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .person__photo {
    flex: none;
    width: 104px;
    height: 104px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    background: var(--pale-blue);
    box-shadow: 0 0 0 1px var(--line), 0 0 0 5px var(--pale-blue);
  }

  .person__photo--initials {
    display: grid;
    place-items: center;
    background: var(--navy);
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: 0.04em;
  }

  .person h3 {
    font-size: 1.1rem;
    margin-top: 1.1rem;
  }

  .person__role {
    color: var(--gold);
    font-weight: 600;
    font-size: 0.85rem;
    line-height: 1.35;
    margin-top: 0.4rem;
    /* reserve two lines so cards with a one-line role stay level */
    min-height: 2.7em;
  }

  .person__bioblock {
    width: 100%;
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .person__bio {
    position: relative;
    color: var(--slate);
    font-size: 0.9rem;
    line-height: 1.6;
    text-align: left;
    overflow: hidden;
    max-height: 9.5rem;
  }

  .person.is-expanded .person__bio {
    max-height: none;
  }

  .person__bio p + p {
    margin-top: 0.7rem;
  }

  .person__bio::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2.75rem;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0), var(--white));
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .person.is-expanded .person__bio::after {
    opacity: 0;
  }

  .person__more {
    margin-top: 0.65rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0;
    background: none;
    border: 0;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--navy);
    cursor: pointer;
  }

  .person__more::after {
    content: "";
    width: 0.46rem;
    height: 0.46rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.2s ease;
  }

  .person.is-expanded .person__more::after {
    transform: translateY(1px) rotate(-135deg);
  }

  .person__more:hover {
    color: var(--gold);
  }

  .person__more[hidden] {
    display: none;
  }

  .person__bio-pending {
    width: 100%;
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    text-align: center;
    color: var(--slate);
    font-style: italic;
    font-size: 0.9rem;
  }

  /* Contact */
  .contact {
    background: var(--navy);
    color: var(--white);
    padding-block: clamp(2.75rem, 5.5vw, 4.25rem) clamp(1.75rem, 3vw, 2.25rem);
  }

  .contact__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .contact__inner > div:first-child {
    max-width: 40rem;
  }

  .contact .eyebrow {
    color: var(--gold-soft);
    display: block;
    margin-bottom: 0.8rem;
  }

  .contact h2 {
    color: var(--white);
    margin-bottom: 0.9rem;
  }

  .contact .lede {
    color: color-mix(in srgb, var(--white) 82%, var(--navy));
  }

  .contact__actions {
    display: grid;
    gap: 0.85rem;
    min-width: 15rem;
  }

  .contact__actions .btn {
    width: 100%;
    justify-content: center;
  }

  .contact__meta {
    color: color-mix(in srgb, var(--white) 66%, var(--navy));
    font-size: 0.9rem;
    margin-top: 0.15rem;
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }

    .people {
      grid-template-columns: 1fr;
      max-width: 34rem;
      margin-inline: auto;
    }

    .approach__grid,
    .contact__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .cards,
    .partners,
    .people,
    .hero__facts {
      grid-template-columns: 1fr;
    }

    .hero__facts {
      gap: 1.25rem;
    }
  }
</style>

<script>
  // Leadership bios: clamp to a preview height, reveal on "Read more".
  const peopleList = document.querySelector<HTMLElement>(".people");
  const people = Array.from(document.querySelectorAll<HTMLElement>(".person"));

  const syncExpandedState = () => {
    peopleList?.classList.toggle(
      "has-expanded",
      people.some((p) => p.classList.contains("is-expanded")),
    );
  };

  const syncToggles = () => {
    for (const person of people) {
      const bio = person.querySelector<HTMLElement>("[data-bio]");
      const toggle = person.querySelector<HTMLButtonElement>("[data-bio-toggle]");
      if (!bio || !toggle || person.classList.contains("is-expanded")) continue;
      // scrollHeight is the full text height; clientHeight is the clamped preview
      toggle.hidden = bio.scrollHeight - bio.clientHeight <= 4;
    }
  };

  for (const person of people) {
    const toggle = person.querySelector<HTMLButtonElement>("[data-bio-toggle]");
    const label = person.querySelector<HTMLElement>("[data-more-label]");
    if (!toggle || !label) continue;
    toggle.addEventListener("click", () => {
      const expanded = person.classList.toggle("is-expanded");
      toggle.setAttribute("aria-expanded", String(expanded));
      label.textContent = expanded ? "Read less" : "Read more";
      syncExpandedState();
    });
  }

  syncToggles();
  let raf = 0;
  window.addEventListener("resize", () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(syncToggles);
  });
</script>
