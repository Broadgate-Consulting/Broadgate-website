---
import BrandLockup from "./BrandLockup.astro";
import { nav, site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div class="identity">
      <BrandLockup size="lg" />
      <p class="identity__tagline">{site.slogan}</p>
    </div>

    <div class="footer-cols">
      <nav class="footer-col" aria-label="Footer">
        <h2 class="footer-col__label">Sections</h2>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer-col">
        <h2 class="footer-col__label">Contact</h2>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.linkedin} rel="noopener">LinkedIn</a></li>
          <li>{site.location}</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="container legal">
    <p>
      &copy; {year} {site.legalName}. Registered in England &amp; Wales, company no.
      {site.companyNumber}. Formerly {site.formerName}.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: color-mix(in srgb, var(--white) 82%, var(--navy));
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem) 1.5rem;
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2.25rem 4.5rem;
  }

  .identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: fit-content;
  }

  .identity__tagline {
    margin-top: 0.4rem;
    color: var(--white);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .footer-cols {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem 3.5rem;
    padding-top: 0.4rem;
  }

  .footer-col__label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-soft);
    margin-bottom: 0.85rem;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }

  .site-footer a {
    color: color-mix(in srgb, var(--white) 82%, var(--navy));
    text-decoration: none;
    font-size: 0.95rem;
  }

  .site-footer a:hover {
    color: var(--white);
    text-decoration: underline;
  }

  .legal {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    padding-top: 1.4rem;
    border-top: 1px solid color-mix(in srgb, var(--white) 16%, transparent);
  }

  .legal p {
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--white) 60%, var(--navy));
  }

  @media (max-width: 720px) {
    .grid {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 2rem;
    }

    .footer-cols {
      justify-content: center;
      gap: 2rem 2.5rem;
    }
  }
</style>
