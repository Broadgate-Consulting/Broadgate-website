---
import BrandLockup from "./BrandLockup.astro";
import { nav, site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div class="identity">
      <BrandLockup size="lg" />
      <p class="identity__tagline">{site.slogan}</p>
    </div>

    <nav aria-label="Footer">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="contact">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.linkedin} rel="noopener">LinkedIn</a>
      <span>{site.location}</span>
    </div>
  </div>

  <div class="container legal">
    <p>
      &copy; {year} {site.legalName}. Registered in England &amp; Wales, company no.
      {site.companyNumber}. Formerly {site.formerName}.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: color-mix(in srgb, var(--white) 82%, var(--navy));
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: fit-content;
  }

  .identity__tagline {
    margin-top: 0.4rem;
    color: var(--white);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-align: center;
  }

  nav ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .contact {
    display: grid;
    gap: 0.6rem;
  }

  .site-footer a {
    color: color-mix(in srgb, var(--white) 82%, var(--navy));
    text-decoration: none;
    font-size: 0.95rem;
  }

  .site-footer a:hover {
    color: var(--white);
    text-decoration: underline;
  }

  .legal {
    margin-top: 2.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--white) 16%, transparent);
  }

  .legal p {
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--white) 60%, var(--navy));
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
