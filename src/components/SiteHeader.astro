---
import { Image } from "astro:assets";
import BrandLockup from "./BrandLockup.astro";
import lockup from "../assets/broadgate-lockup.png";
import { nav, site } from "../data/site";

const triggerLabel = "Menu";
---

<header class="banner" id="site-top">
  <div class="container banner__inner">
    <div class="banner__row">
      <a class="banner__brand" href="#site-top" aria-label={`${site.name} — ${site.slogan}`}>
        <Image
          src={lockup}
          alt={`${site.name} — ${site.slogan}`}
          widths={[360, 560, 900]}
          sizes="(max-width: 640px) 300px, 460px"
          loading="eager"
        />
      </a>
      <button
        class="nav-trigger"
        data-nav-open
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Open menu"
      >
        <span class="nav-trigger__lines" aria-hidden="true"></span>
        <span class="nav-trigger__label">{triggerLabel}</span>
      </button>
    </div>
    <p class="banner__eyebrow">
      Financial services &amp; insurance consulting &mdash; {site.location}
    </p>
  </div>
</header>

<div class="stickybar" data-stickybar>
  <div class="container stickybar__inner">
    <a class="stickybar__brand" href="#site-top" aria-label={`${site.name} — top`}>
      <BrandLockup size="sm" />
    </a>
    <button
      class="nav-trigger nav-trigger--compact"
      data-nav-open
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Open menu"
    >
      <span class="nav-trigger__lines" aria-hidden="true"></span>
      <span class="nav-trigger__label">{triggerLabel}</span>
    </button>
  </div>
</div>

<div class="navmenu" id="site-menu" data-navmenu hidden>
  <div class="navmenu__backdrop" data-nav-close></div>
  <div class="navmenu__panel" role="dialog" aria-modal="true" aria-label="Site navigation">
    <button class="navmenu__close" data-nav-close aria-label="Close menu">
      <span aria-hidden="true">&times;</span>
    </button>
    <nav aria-label="Sections">
      <ul>
        {
          nav.map((item, i) => (
            <li>
              <a href={item.href} data-nav-close>
                <span class="navmenu__num">{String(i + 1).padStart(2, "0")}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="navmenu__foot">
      <a class="btn btn--primary" href={`mailto:${site.email}`} data-nav-close>
        Get in touch
      </a>
      <a class="navmenu__link" href={site.linkedin} rel="noopener">LinkedIn</a>
    </div>
  </div>
</div>

<style>
  .banner {
    background: var(--navy);
    color: var(--white);
    position: relative;
    padding-block: clamp(1rem, 2.5vw, 1.6rem) clamp(2.25rem, 6vw, 4rem);
  }

  .banner__inner {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    align-items: flex-start;
  }

  .banner__row {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .banner__brand {
    display: block;
  }

  .banner__brand img {
    width: clamp(220px, 52vw, 500px);
    height: auto;
  }

  @media (max-width: 560px) {
    .nav-trigger__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .nav-trigger {
      gap: 0;
      padding: 0.6rem 0.7rem;
    }
  }

  .banner__eyebrow {
    font-weight: 700;
    font-size: clamp(0.68rem, 1.5vw, 0.78rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }

  /* Trigger button — shared look */
  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font: inherit;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--white);
    background: color-mix(in srgb, var(--white) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--white) 30%, transparent);
    border-radius: 999px;
    padding: 0.55rem 1.05rem;
    cursor: pointer;
    transition: background-color 0.18s ease, border-color 0.18s ease;
  }

  .nav-trigger:hover {
    background: color-mix(in srgb, var(--white) 18%, transparent);
    border-color: color-mix(in srgb, var(--white) 55%, transparent);
  }

  .nav-trigger__lines,
  .nav-trigger__lines::before,
  .nav-trigger__lines::after {
    content: "";
    display: block;
    width: 16px;
    height: 2px;
    background: currentColor;
  }
  .nav-trigger__lines::before {
    transform: translateY(-5px);
  }
  .nav-trigger__lines::after {
    transform: translateY(3px);
  }

  /* Sticky compact bar */
  .stickybar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 45;
    background: color-mix(in srgb, var(--navy) 94%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid color-mix(in srgb, var(--white) 12%, transparent);
    transform: translateY(-100%);
    transition: transform 0.25s ease;
  }

  .stickybar[data-visible] {
    transform: translateY(0);
  }

  .stickybar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    gap: 1rem;
  }

  .stickybar__brand {
    text-decoration: none;
  }

  .nav-trigger--compact {
    padding: 0.45rem 0.9rem;
  }

  /* Overlay menu */
  .navmenu {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    justify-content: flex-end;
  }

  .navmenu[hidden] {
    display: none;
  }

  .navmenu__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--ink) 55%, transparent);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .navmenu__panel {
    position: relative;
    width: min(420px, 88vw);
    background: var(--navy);
    color: var(--white);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
    transform: translateX(100%);
    transition: transform 0.25s ease;
    overflow-y: auto;
  }

  .navmenu[data-open] .navmenu__backdrop {
    opacity: 1;
  }
  .navmenu[data-open] .navmenu__panel {
    transform: translateX(0);
  }

  .navmenu__close {
    align-self: flex-end;
    width: 44px;
    height: 44px;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--white);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--white) 25%, transparent);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .navmenu__close:hover {
    background: color-mix(in srgb, var(--white) 12%, transparent);
  }

  .navmenu nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }

  .navmenu nav a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.8rem 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 4vw, 1.5rem);
    text-decoration: none;
    color: var(--white);
    border-bottom: 1px solid color-mix(in srgb, var(--white) 12%, transparent);
    transition: color 0.15s ease, padding-left 0.15s ease;
  }

  .navmenu nav a:hover {
    color: var(--gold-soft);
    padding-left: 0.4rem;
  }

  .navmenu__num {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--gold-soft);
  }

  .navmenu__foot {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: auto;
  }

  .navmenu__foot .btn {
    width: 100%;
    justify-content: center;
  }

  .navmenu__link {
    font-weight: 600;
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--white) 78%, var(--navy));
  }

  :global(body.nav-open) {
    overflow: hidden;
  }
</style>

<script>
  const menu = document.querySelector<HTMLElement>("[data-navmenu]");
  const openers = document.querySelectorAll<HTMLButtonElement>("[data-nav-open]");
  const closers = document.querySelectorAll<HTMLElement>("[data-nav-close]");
  const stickybar = document.querySelector<HTMLElement>("[data-stickybar]");
  const banner = document.getElementById("site-top");
  let lastFocused: HTMLElement | null = null;

  const openMenu = () => {
    if (!menu) return;
    lastFocused = document.activeElement as HTMLElement;
    menu.hidden = false;
    void menu.offsetWidth; // force reflow so the transition runs
    menu.setAttribute("data-open", "");
    document.body.classList.add("nav-open");
    openers.forEach((b) => b.setAttribute("aria-expanded", "true"));
    menu.querySelector<HTMLElement>(".navmenu__close")?.focus();
  };

  const closeMenu = () => {
    if (!menu) return;
    menu.removeAttribute("data-open");
    document.body.classList.remove("nav-open");
    openers.forEach((b) => b.setAttribute("aria-expanded", "false"));
    window.setTimeout(() => {
      menu.hidden = true;
    }, 250);
    lastFocused?.focus();
  };

  openers.forEach((b) => b.addEventListener("click", openMenu));
  closers.forEach((el) => el.addEventListener("click", closeMenu));

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu && !menu.hidden) closeMenu();
  });

  if (stickybar && banner) {
    const sync = () => {
      const threshold = banner.offsetHeight - 8;
      stickybar.toggleAttribute("data-visible", window.scrollY > threshold);
    };
    sync();
    window.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync, { passive: true });
  }
</script>
