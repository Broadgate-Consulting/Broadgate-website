---
import { Image } from "astro:assets";
import symbol from "../assets/broadgate-symbol-alpha.png";
import { site } from "../data/site";

interface Props {
  size?: "sm" | "lg" | "banner";
  slogan?: boolean;
  class?: string;
}
const { size = "sm", slogan = false, class: className } = Astro.props;
---

<span class:list={["lockup", `lockup--${size}`, className]}>
  <Image class="lockup__mark" src={symbol} alt="" widths={[80, 160, 260]} sizes="120px" />
  <span class="lockup__text">
    <span class="lockup__name">Broadgate</span>
    <span class="lockup__sub">Consulting</span>
    {slogan && <span class="lockup__slogan">{site.slogan}</span>}
  </span>
  <span class="sr-only">{site.name} — {site.slogan}</span>
</span>

<style>
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    color: var(--white);
    line-height: 1;
  }

  .lockup__mark {
    flex: none;
    width: auto;
    object-fit: contain;
  }

  .lockup__text {
    display: flex;
    flex-direction: column;
  }

  .lockup__name {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .lockup__sub {
    color: var(--gold-soft);
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.22em;
    margin-top: 0.4em;
  }

  .lockup__slogan {
    margin-top: 0.7em;
    padding-top: 0.6em;
    border-top: 2px solid var(--gold);
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--white);
  }

  /* sm — sticky bar */
  .lockup--sm .lockup__mark {
    height: 34px;
  }
  .lockup--sm .lockup__name {
    font-size: 1rem;
  }
  .lockup--sm .lockup__sub {
    font-size: 0.58rem;
    letter-spacing: 0.3em;
  }

  /* lg — footer */
  .lockup--lg .lockup__mark {
    height: 54px;
  }
  .lockup--lg .lockup__name {
    font-size: 1.6rem;
  }
  .lockup--lg .lockup__sub {
    font-size: 0.74rem;
  }

  /* banner — page header */
  .lockup--banner {
    gap: clamp(0.7rem, 2.2vw, 1.5rem);
  }
  .lockup--banner .lockup__mark {
    height: clamp(48px, 8vw, 104px);
  }
  .lockup--banner .lockup__name {
    font-size: clamp(1.35rem, 6vw, 3.1rem);
    letter-spacing: 0.08em;
  }
  .lockup--banner .lockup__sub {
    font-size: clamp(0.62rem, 2.6vw, 1.28rem);
    letter-spacing: 0.12em;
  }
  .lockup--banner .lockup__slogan {
    font-size: clamp(0.8rem, 2.1vw, 1.1rem);
  }

  @media (min-width: 560px) {
    .lockup--banner .lockup__name {
      letter-spacing: 0.14em;
    }
    .lockup--banner .lockup__sub {
      letter-spacing: 0.18em;
    }
  }
  @media (min-width: 800px) {
    .lockup--banner .lockup__name {
      letter-spacing: 0.2em;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
